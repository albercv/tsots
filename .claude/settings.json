{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardia_git.py\"",
            "timeout": 600,
            "statusMessage": "Guardia de git (push, atribución, tests antes del commit)"
          }
        ]
      }
    ]
  }
}
