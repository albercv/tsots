<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Agente del blog. instalar.command cambia @PROYECTO@ y @DIR_BLOG@ y lo copia
     en ~/Library/LaunchAgents/com.tsots.blog.plist. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tsots.blog</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PROYECTO@/lanzador/blog/procesar_pendientes.sh</string>
        <string>@DIR_BLOG@</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>@DIR_BLOG@/pendientes</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>@DIR_BLOG@/agente.log</string>
    <key>StandardErrorPath</key>
    <string>@DIR_BLOG@/agente.log</string>
</dict>
</plist>
