msgstr "The app re-encodes the video with h264_videotoolbox and retries automatically. If it still fails, re-encode by hand: ffmpeg -i input.mp4 -c:v h264_videotoolbox -b:v 14M -c:a copy output.mp4"

msgid "La respuesta del modelo no es JSON válido"
msgstr "The model's response is not valid JSON"

